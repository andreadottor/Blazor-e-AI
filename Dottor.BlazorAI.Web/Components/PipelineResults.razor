@using Dottor.BlazorAI.Web.Pipeline

@if (DocumentId is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <div><strong>Documento:</strong> @FileName</div>
            <div class="text-secondary small"><strong>Document ID:</strong> @DocumentId</div>
            @if (JobId is not null)
            {
                <div class="text-secondary small"><strong>Job ID:</strong> @JobId</div>
            }
            <div class="text-secondary small"><strong>Stato:</strong> @(PersistentStatus ?? JobStatus)</div>
            <a class="btn btn-sm btn-outline-secondary mt-2" href="@($"/documents/{DocumentId}/pdf")" target="_blank">
                Apri PDF originale
            </a>
        </div>
    </div>
}

@if (ApprovalPending && !string.IsNullOrWhiteSpace(ImagePrompt))
{
    <section class="result-section border border-warning rounded p-3 mb-4">
        <h2 class="h5 text-warning">⚠ In attesa di approvazione</h2>
        <label class="form-label" for="imagePrompt"><strong>Prompt proposto</strong></label>
        @if (isEditingPrompt)
        {
            <textarea id="imagePrompt" class="form-control mb-3" rows="7" @bind="editedPrompt" @bind:event="oninput" disabled="@ApprovalResponsePending"></textarea>
            <button class="btn btn-success me-2" @onclick="ApproveEditedAsync" disabled="@ApprovalResponsePending">
                Approva modifiche
            </button>
            <button class="btn btn-outline-secondary" @onclick="CancelEditing" disabled="@ApprovalResponsePending">
                Annulla modifica
            </button>
        }
        else
        {
            <div class="bg-body-tertiary border rounded p-3 mb-3 preserve-lines">@ImagePrompt</div>
            <button class="btn btn-success me-2" @onclick="ApproveAsync" disabled="@ApprovalResponsePending">Approva</button>
            <button class="btn btn-outline-primary me-2" @onclick="BeginEditing" disabled="@ApprovalResponsePending">Modifica</button>
            <button class="btn btn-outline-danger" @onclick="RejectAsync" disabled="@ApprovalResponsePending">Rifiuta</button>
        }
    </section>
}

@if (Updates.Count > 0)
{
    <ol class="pipeline-steps list-unstyled mb-4">
        @foreach (var update in Updates)
        {
            <li class="mb-2 @CssClass(update.Status)">
                <span class="step-icon">@Icon(update.Status)</span>
                <strong>@StepName(update.Step)</strong>
                @if (!string.IsNullOrWhiteSpace(update.Message) && update.Status == PipelineUpdateStatus.Failed)
                {
                    <span> — @update.Message</span>
                }
            </li>
        }
    </ol>
}

@if (!string.IsNullOrWhiteSpace(Summary))
{
    <section class="result-section">
        <h2>Riassunto</h2>
        <p class="preserve-lines">@Summary</p>
    </section>
}

@if (!string.IsNullOrWhiteSpace(Category))
{
    <section class="result-section">
        <h2>Categoria</h2>
        <p>@Category</p>
    </section>
}

@if (ImageAvailable && DocumentId is not null)
{
    <section class="result-section">
        <h2>Immagine</h2>
        <img class="generated-image" src="@($"/documents/{DocumentId}/image?v={ImageVersion}")" alt="Immagine generata dal documento" />
    </section>
}
