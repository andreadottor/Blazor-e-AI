@page "/demo3"
@implements IAsyncDisposable
@using Dottor.BlazorAI.Web.Pipeline
@using Dottor.BlazorAI.Web.Services
@inject DocumentService Documents
@inject DocumentPipelineService Pipeline

<PageTitle>Demo 3 - Pipeline AI</PageTitle>

<h1>Demo 3 — Pipeline AI</h1>
<p class="lead"><code>IAsyncEnumerable&lt;T&gt;</code> trasporta gli aggiornamenti di un processo, non soltanto token.</p>

<div class="demo-panel">
    <label class="form-label" for="pdf3">Scegli un PDF (massimo 10 MB)</label>
    <InputFile id="pdf3" class="form-control" OnChange="ProcessAsync" accept="application/pdf,.pdf" disabled="@isProcessing" />
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-4">@error</div>
}

<div class="mt-4">
    <PipelineResults DocumentId="documentId"
                     FileName="@fileName"
                     Updates="updates"
                     Summary="@summary"
                     Category="@category"
                     ImageAvailable="imageAvailable"
                     ImagePrompt="@imagePrompt"
                     ApprovalPending="approvalPending"
                     ApprovalResponsePending="approvalResponsePending"
                     OnApprove="ApproveAsync"
                     OnReject="RejectAsync" />
</div>
