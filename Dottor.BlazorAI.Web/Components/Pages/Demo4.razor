@page "/demo4"
@page "/documents/{Id:guid}"
@implements IAsyncDisposable
@using Dottor.BlazorAI.Web.Background
@using Dottor.BlazorAI.Web.Data
@using Dottor.BlazorAI.Web.Pipeline
@using Dottor.BlazorAI.Web.Services
@inject DocumentService Documents
@inject DocumentJobService Jobs
@inject NavigationManager Navigation

<PageTitle>Demo 4 - Background processing</PageTitle>

<h1>Demo 4 — Background processing con Channel&lt;T&gt;</h1>
<p class="lead">SQL conserva lo stato, i Channel consegnano gli aggiornamenti live, l'email richiama l'utente quando non osserva.</p>

<div class="alert alert-secondary small">
    Il lavoro continua senza questa pagina. I live update sono effimeri: dopo un refresh lo stato viene ricostruito da SQL Server.
</div>

<div class="demo-panel">
    <label class="form-label" for="pdf4">Scegli un PDF (massimo 10 MB)</label>
    <InputFile id="pdf4" class="form-control" OnChange="StartAsync" accept="application/pdf,.pdf" disabled="@(isStarting || isListening)" />
</div>

@if (documentId is not null && IsActiveStatus(persistentStatus))
{
    <div class="alert alert-info small mt-3 mb-0">
        @(isListening ? "Live updates connected" : "Listening for updates...")
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-4">@error</div>
}

<div class="mt-4">
    <PipelineResults DocumentId="documentId"
                     JobId="jobId"
                     FileName="@fileName"
                     PersistentStatus="@StatusName(persistentStatus)"
                     Updates="updates"
                     Summary="@summary"
                     Category="@category"
                     ImageAvailable="imageAvailable"
                     ImagePrompt="@imagePrompt"
                     ApprovalPending="approvalPending"
                     ApprovalResponsePending="approvalResponsePending"
                     OnApprove="ApproveAsync"
                     OnReject="RejectAsync" />
</div>

